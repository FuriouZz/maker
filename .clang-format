---
BasedOnStyle: WebKit
AlignAfterOpenBracket: BlockIndent
UseTab: Never
UseCRLF: false
IndentWidth: 4
# ColumnLimit: 80
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: true
  AcrossComments: true
  AlignCompound: false
  AlignFunctionPointers: false
  PadOperators: false
AlignConsecutiveAssignments:
  Enabled: true
