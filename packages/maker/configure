#!/usr/bin/env bash

tolower()
{
    echo "$@" | tr ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz
}

add_library()
{
    local path="$1"
    shift
    CLIBRARIES="$CLIBRARIES -L$path -Wl,-rpath,$path $*"
}

add_include()
{
    CINCLUDES="$CINCLUDES -I$1"
}

build_ffmpeg()
{
    local FFMPEG_DIR="$CWD/vendors/ffmpeg"
    local FFMPEG_SOURCE_DIR="$FFMPEG_DIR/src"
    local FFMPEG_BUILD_DIR="$FFMPEG_DIR/build"

    if [ ! -f "$FFMPEG_DIR/ffmpeg.built" ]; then
        if [ ! -d "$FFMPEG_SOURCE_DIR" ]; then
            git clone https://git.ffmpeg.org/ffmpeg.git --depth=1 $FFMPEG_SOURCE_DIR
        fi

        cd $FFMPEG_SOURCE_DIR

        echo "Configure ffmpeg"
        ./configure \
            --prefix=$FFMPEG_BUILD_DIR \
            --disable-programs \
            --disable-static \
            --disable-doc \
            --enable-shared \
            --enable-pic \
            --enable-cross-compile \
            --enable-swscale \
            --enable-debug=2

        echo "Build ffmpeg"
        make
    
        echo "Install ffmpeg"
        make install

        touch "$FFMPEG_DIR/ffmpeg.built"

        cd $CWD
    else
        echo "ffmpeg already built"
    fi

    add_include "$FFMPEG_BUILD_DIR/include"
    add_library "$FFMPEG_BUILD_DIR/lib" \
         "-lavutil" \
         "-lswresample" \
         "-lavcodec" \
         "-lavformat" \
         "-lswscale" \
         "-lavfilter" \
         "-lavdevice"
}

build_odin_bindgen() {
    local BINDGEN_DIR="$CWD/vendors/odin-c-bindgen"
    local BINDGEN_SOURCE_DIR="$BINDGEN_DIR/src"
    local BINDGEN_BUILD_DIR="$BINDGEN_DIR/build"

    if [ ! -f "$BINDGEN_DIR/bindgen.built" ]; then
        if [ ! -d "$BINDGEN_SOURCE_DIR" ]; then
            git clone git@github.com:karl-zylinski/odin-c-bindgen.git --depth=1 $BINDGEN_SOURCE_DIR
        fi

        cd $BINDGEN_SOURCE_DIR

        echo "Build bindgen"
        odin build src -out:bindgen

        touch "$BINDGEN_SOURCE_DIR/bindgen.built"

        cd $CWD
    else
        echo "bindgen already built"
    fi
}

CWD=$(cd $(dirname "$0"); pwd)
BUILD_DIR="$CWD/target/\$(PROFILE)"
LDFLAGS=""
CLIBRARIES=""
CINCLUDES=""
LIBRARY_NAME="maker.dylib"
MEMCHECK=""

build_ffmpeg
build_odin_bindgen
add_include "$CWD/src/include"

target_os=$(tolower $(uname -s))

case $target_os in
    darwin)
        LDFLAGS="-dynamiclib"
        MEMCHECK="/usr/bin/leaks"
        MEMCHECK_ARGS="--atExit --"
    ;;
    linux)
        LDFLAGS="-shared"
        MEMCHECK="/usr/bin/valgrind"
        MEMCHECK_ARGS=""
    ;;
esac

LDFLAGS="$LDFLAGS -fsanitize=address"

cat > config.make <<EOF
# Automatically generated by configure - do not modify!

# Disable implicit rules so canonical targets will work.
.SUFFIXES:

PROFILE?=debug

CC=gcc

SOURCE_DIR=$CWD/src/core
BUILD_DIR=$BUILD_DIR

TEST_SOURCE_DIR=$CWD/tests
TEST_BUILD_DIR=$BUILD_DIR/tests

LIBRARY_NAME=$LIBRARY_NAME
LIBRARY_PATH=$BUILD_DIR/$LIBRARY_NAME

CINCLUDES=$CINCLUDES
CLIBRARIES=$CLIBRARIES

LDFLAGS=$LDFLAGS

ifeq (\$(PROFILE),release)
CFLAGS += -O2
else
CFLAGS += -g -O0 -fsanitize=address
endif


MEMCHECK=$MEMCHECK
MEMCHECK_ARGS=$MEMCHECK_ARGS
EOF

echo "config.make generated"
