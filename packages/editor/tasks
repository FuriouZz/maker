#!/usr/bin/env bash

function _get_os {
  case $(uname | tr '[:upper:]' '[:lower:]') in
    linux*)
       echo linux
      ;;
    darwin*)
       echo darwin
      ;;
    msys*)
       echo windows
      ;;
    *)
       echo notset
      ;;
  esac
}

function _get_arch {
  echo $(uname -m)
}

function _get_target {
  echo "$(_get_os)_$(_get_arch)"
}

function _odin {
  command=$1;shift
  target=$2;shift

  target=${target:-$(_get_target)}
  output="target/debug"

  collections="-collection:maker=../maker/bindings"

  mkdir -p target
  odin $command ./src -target=$target $collections $@
  # odin $command ./src -out="$output/main-$target" -target=$target $collections $@
}

function build {
  _odin build
}

function run {
  _odin run
}

function help {
  printf "%s <task> [args]\n\nTasks:\n" "${0}"

  compgen -A function | grep -v "^_" | cat -n

  printf "\nExtended help:\n  Each task has comments for general usage\n"
}

# This idea is heavily inspired by: https://github.com/adriancooney/Taskfile
TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
